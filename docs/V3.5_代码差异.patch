+    def uncovered_capital(self):
+        """Allocate observed inventory once; an absent prerequisite is not coverage."""
+        rows = self.service_candidates()
+        available = Counter()
+        covered = set()
+        for actor, char in sorted(self.characters.items()):
+            bag = inventory(char) or Counter()
+            remaining = Counter(bag)
+            for order in self.state.get('delivery_orders', {}).get(actor, []):
+                key = order.get('target'), order.get('item')
+                if key[1] == 'WallFixer' or key in covered or remaining[key[1]] <= 0:
+                    continue
+                if any((t['id'], n) == key for _, t, n in rows):
+                    covered.add(key)
+                    remaining[key[1]] -= 1
+            available.update(remaining)
+        for _, target, name in rows:
+            key = target['id'], name
+            if name != 'WallFixer' and key not in covered and available[name] > 0:
+                covered.add(key)
+                available[name] -= 1
+        return [row for row in rows if (row[1]['id'], row[2]) not in covered]
