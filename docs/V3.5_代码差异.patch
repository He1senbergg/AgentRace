+    def wall_budget(self):
+        """Experimental daily caps, NOT sufficient-health guarantees.
+
+        No paid level-three wall until all three guns are level three. Side arms
+        stay level one until the battery is complete; damaged front cells only.
+        """
+        day = self.phase.day if self.phase else 1
+        levels = [level_of(w) or 0 for w in self.weapons]
+        globals_ready = sum(level == 3 for level in levels)
+        complete = len(levels) == 3 and globals_ready == 3
+        front = 1 if day <= 2 or globals_ready < 2 else 2
+        if day >= 6 and complete:
+            front = 3
+        flank = 2 if day >= 5 and complete else 1
+        limit = 0 if day == 1 else 20 if day == 2 else 40 if day <= 4 else 60
+        spent = self.state.get('maintenance_spent', 0) + self.maintenance_reserved
+        return dict(day=day, front_level_cap=front, flank_level_cap=flank,
+                    daily_gold_cap=limit, gold_left=max(0, limit-spent),
+                    global_batteries=globals_ready, complete_battery=complete,
+                    stock_fixers=1 if not complete else 2)
