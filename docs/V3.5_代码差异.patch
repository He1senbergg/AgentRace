+def economy_window(world, phase):
+    """Legal work time before the NEXT wave, not a fabricated daytime phase.
+
+    Official rules: robots are globally visible and spawn once, at night start.
+    Unknown/malformed robot data and that spawn round are never called clear.
+    Opponent-targeted robots still block a work corridor within attack distance.
+    Returns (available turns, cleared-night flag, hazardous cells).
+    """
+    if phase is None:
+        return 0, False, frozenset()
+    left_in_match = (10 - phase.day) * 130 + 131 - phase.round_in_day
+    if phase.is_day:
+        return min(71 - phase.round_in_day, left_in_match), False, frozenset()
+    robots = world.data.get('robot')
+    entries = robots.get('roles') if isinstance(robots, dict) else robots
+    if not isinstance(entries, list) or phase.round_in_day <= 71:
+        return 0, False, frozenset()
+    side = world.our.get('type')
+    if side not in ('challenger', 'defender'):
+        return 0, False, frozenset()
+    hazards = set()
+    bases = [r for r in world.roles.values() if r.get('roleType') == 'station']
+    if not bases:
+        return 0, False, frozenset()
+    home = set().union(*(station_cells(b['cell']) for b in bases))
+    for r in entries:
+        if not isinstance(r, dict) or not valid_position(r.get('pos')):
+            return 0, False, frozenset()
+        hp = r.get('health')
+        if type(hp) not in (int, float) or not math.isfinite(hp):
+            return 0, False, frozenset()
+        if hp <= 0:
+            continue
+        target = r.get('targetTeam')
+        if target not in ('challenger', 'defender') or target == side:
+            return 0, False, frozenset()
+        cell = position(r['pos'])
+        # Foreign robots close to the base are not a safe release condition.
+        if min(distance(cell, h) for h in home) <= 6:
+            return 0, False, frozenset()
+        # Attack range three, plus one next-move margin. Re-evaluate each turn.
+        for x in range(max(0, cell[0]-4), min(41, cell[0]+5)):
+            for y in range(max(0, cell[1]-4), min(32, cell[1]+5)):
+                hazards.add((x, y))
+    return min(201 - phase.round_in_day, left_in_match), True, frozenset(hazards)
+
+
+def work_path(world, start, goals, reserved=(), hazards=()):
+    """Path around live robot attack zones without altering action legality."""
+    geometry = object.__new__(World)
+    geometry.occupied = world.occupied | set(hazards)
+    return geometry.path(start, goals, set(reserved))
 
 
